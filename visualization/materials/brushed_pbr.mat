material {
    name : qhrr_brushed_pbr,
    specularAntiAliasing : true,
    specularAntiAliasingVariance : 0.015,
    specularAntiAliasingThreshold : 0.08,
    shadingModel : lit,
    flipUV: false,
    parameters : [
        { type : sampler2d, name : BaseColor },
        { type : sampler2d, name : Normal },
        { type : sampler2d, name : Occlusion },
        { type : sampler2d, name : Roughness },
        { type : sampler2d, name : Metallic },
        { type : sampler2d, name : Emissive },
        { type : float4, name : BaseColorFactor },
        { type : float, name : MetallicFactor },
        { type : float, name : RoughnessFactor },
        { type : float, name : EmissiveFactor },
        { type : float3, name : UvScale },
        { type : float3, name : UvOffset }

    ],
    requires : [
        uv0
    ]
}

fragment {
  void material(inout MaterialInputs material) {
    vec2 uv = getUV0() * materialParams.UvScale.xy + materialParams.UvOffset.xy;

    material.normal = texture(materialParams_Normal, uv).xyz * 2.0 - 1.0;
    prepareMaterial(material);

    material.baseColor        = materialParams.BaseColorFactor;
    material.baseColor        *= texture(materialParams_BaseColor, uv);
    material.ambientOcclusion = texture(materialParams_Occlusion, uv).r;
    material.roughness        = materialParams.RoughnessFactor;
    material.roughness        *= texture(materialParams_Roughness, uv).r;
    material.metallic         = materialParams.MetallicFactor;
    material.metallic         *= texture(materialParams_Metallic, uv).r;
    // Match the brushing axis to the UV surface derivative rather than to a
    // screen-space pattern. Degenerate projections stay isotropic.
    vec2 duvx = dFdx(uv), duvy = dFdy(uv);
    vec3 dpx = dFdx(getWorldPosition()), dpy = dFdy(getWorldPosition());
    float determinant = duvx.x * duvy.y - duvx.y * duvy.x;
    vec3 brushWorld = dpx * duvy.y - dpy * duvx.y;
    vec3 brushLocal = transpose(getWorldTangentFrame()) * brushWorld;
    float directionLength = length(brushLocal.xy);
    float validDirection = step(1e-10, abs(determinant)) * step(1e-10, directionLength);
    material.anisotropy = 0.38 * smoothstep(0.7, 1.0, material.metallic) * validDirection;
    material.anisotropyDirection = directionLength > 1e-10
        ? vec3(brushLocal.xy / directionLength, 0.0) : vec3(1.0, 0.0, 0.0);
    material.emissive         = texture(materialParams_Emissive, uv);
    material.emissive.rgb     *= materialParams.EmissiveFactor;
    material.emissive.a       = (1.0 - material.emissive.a) *
                                materialParams.EmissiveFactor;
  }
}
