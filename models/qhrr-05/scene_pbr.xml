<mujoco model="qhrr-05 visualization only">
  <!-- Never pass this file to the physics process. Original MJCF stays unchanged. -->
  <include file="scene.xml"/>
  <include file="visualization/pbr_assets.xml"/>
  <visual>
    <quality shadowsize="2048" offsamples="8"/>
    <headlight active="0" diffuse="1 1 1" ambient="0 0 0"/>
  </visual>
  <custom>
    <numeric name="filament.ao.enabled" data="1"/>
    <text name="filament.ao.quality" data="ultra"/>
    <text name="filament.cg.tone_mapping" data="aces"/>
    <numeric name="filament.cg.exposure" data="0.0"/>
    <numeric name="filament.cg.contrast" data="1.0"/>
    <numeric name="filament.cg.saturation" data="1.0"/>
    <numeric name="filament.fallback.head_light_intensity" data="0"/>
    <numeric name="filament.fallback.scene_light_intensity" data="22000"/>
    <numeric name="filament.fallback.environment_light_intensity" data="40000"/>
    <text name="filament.shadows.type" data="pcss"/>
    <numeric name="filament.shadows.map_size" data="2048"/>
    <numeric name="filament.bloom.enabled" data="0"/>
    <numeric name="filament.vignette.enabled" data="0"/>
    <numeric name="filament.fog.enabled" data="0"/>
    <!-- Renderer-owned studio spots, separate from the simulation model. -->
    <numeric name="pbr.fill.position" size="3" data="-0.8 1.4 1.1"/>
    <numeric name="pbr.fill.direction" size="3" data="0.9 -1.2 -0.7"/>
    <numeric name="pbr.fill.color" size="3" data="0.94 0.97 1"/>
    <numeric name="pbr.fill.intensity" data="3000"/>
    <numeric name="pbr.rim.position" size="3" data="0.6 -0.8 1.3"/>
    <numeric name="pbr.rim.direction" size="3" data="-0.4 0.9 -0.8"/>
    <numeric name="pbr.rim.color" size="3" data="1 0.99 0.97"/>
    <numeric name="pbr.rim.intensity" data="1500"/>
    <!-- Applied only to the viewer's copy of the included legacy scene light. -->
    <numeric name="pbr.key.direction" size="3" data="0.55 -0.65 -0.55"/>
    <numeric name="pbr.key.color" size="3" data="1 0.98 0.96"/>
    <numeric name="pbr.key.radius" data="0.18"/>
  </custom>
</mujoco>
